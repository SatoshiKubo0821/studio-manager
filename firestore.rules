rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return isSignedIn() && myRole() == 'admin'; }
    function isManagerOrAdmin() { return isSignedIn() && (myRole() == 'admin' || myRole() == 'manager'); }
    // Which app a member may use: "studio" (Studio Manager) / "miraiz" (Miraiz Manager).
    // Members without an apps list (invited before it existed) keep both; admins always have both.
    function hasApp(app) {
      let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return me.role == 'admin' || !('apps' in me) || me.apps.hasAny([app]);
    }
    function canUse(app) { return isSignedIn() && hasApp(app); }

    // One-time bootstrap marker. Once the first admin has been created,
    // this doc exists and closes the self-bootstrap path below for good.
    // Result of the daily sheet sync (written by the GitHub Actions job with admin credentials)
    match /system/sheetSync {
      allow read: if isSignedIn();
    }

    match /system/bootstrap {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Member accounts + roles. Anyone signed in can read the member list
    // (needed for the invite flow's bootstrap check); only admins can
    // create/edit/delete member records or change roles for OTHER users.
    //
    // Exception: a signed-in user may create their OWN doc as "admin" if
    // the app has never been bootstrapped yet (system/bootstrap doesn't
    // exist). Without this, nobody could ever become the first admin,
    // because isAdmin() itself requires an existing users/{uid} doc.
    // This path closes permanently once system/bootstrap is written.
    // Pending re-invites keyed by e-mail: a removed member's login account still exists,
    // so instead of creating a new account the admin leaves an invite that the person
    // redeems on their next sign-in (creating their own users/{uid} with the invited role).
    match /invites/{email} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.token.email == email);
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.token.email == email);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow update, delete: if isAdmin();
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        exists(/databases/$(database)/documents/invites/$(request.auth.token.email)) &&
        request.resource.data.role == get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.role &&
        request.resource.data.get('apps', null) == get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.get('apps', null)
      ) || (
        isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'admin' &&
        !exists(/databases/$(database)/documents/system/bootstrap)
      );
    }

    // Studio configuration (plans, pricing, fixed costs, etc.)
    match /studios/{id} {
      allow read: if canUse('studio');
      allow write: if isManagerOrAdmin() && hasApp('studio');
    }

    // Coupons
    match /coupons/{id} {
      allow read: if canUse('studio');
      allow write: if isManagerOrAdmin() && hasApp('studio');
    }

    // Reservations: any signed-in member (including staff) can manage these.
    match /reservations/{id} {
      allow read, write: if canUse('studio');
    }

    // Customer profiles (CRM): contact, tags, memo, caution flag, merges — editable by managers+
    match /customers/{id} {
      allow read: if canUse('studio');
      allow write: if isManagerOrAdmin() && hasApp('studio');
    }

    // Monthly SNS figures per studio (entered by managers)
    match /snsStats/{id} {
      allow read: if canUse('studio');
      allow write: if isManagerOrAdmin() && hasApp('studio');
    }

    // Mail templates
    match /mailTemplates/{id} {
      allow read: if canUse('studio');
      allow write: if isManagerOrAdmin() && hasApp('studio');
    }

    // ---- Miraiz Manager (写真事業・別アプリ。同じアカウント/ロールを使い、users.apps に "miraiz" が必要) ----
    // Bookings & sales: any signed-in member (including staff) can manage these.
    match /photoBookings/{id} {
      allow read, write: if canUse('miraiz');
    }

    // Pricing, products, fixed costs
    match /photoConfig/{id} {
      allow read: if canUse('miraiz');
      allow write: if isManagerOrAdmin() && hasApp('miraiz');
    }
  }
}
